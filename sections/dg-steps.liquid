{{ 'daily-glow.css' | asset_url | stylesheet_tag }}
<section{% if section.settings.anchor != blank %} id="{{ section.settings.anchor | handle }}"{% endif %} class="dg dg--{{ section.settings.style }}" style="--dg-pt: {{ section.settings.padding_top }}px; --dg-pb: {{ section.settings.padding_bottom }}px;">
  <div class="dg__wrap">
    {%- if section.settings.eyebrow != blank or section.settings.heading != blank or section.settings.text != blank -%}
      <div class="dg__head">
        {%- if section.settings.eyebrow != blank %}<p class="dg__eyebrow">{{ section.settings.eyebrow | escape }}</p>{% endif -%}
        {%- if section.settings.heading != blank %}<h2 class="dg__title">{{ section.settings.heading }}</h2>{% endif -%}
        {%- if section.settings.text != blank %}<div class="dg__lede">{{ section.settings.text }}</div>{% endif -%}
      </div>
    {%- endif -%}
    <div class="dg-steps" style="--dg-cols: {{ section.blocks.size | at_most: 4 | at_least: 1 }};">
      {%- for block in section.blocks -%}
        <div class="dg-step" {{ block.shopify_attributes }}>
          <span class="dg-step__num">{% if block.settings.badge != blank %}{% render 'dg-icon', name: block.settings.icon %}{% else %}{{ forloop.index }}{% endif %}</span>
          {%- if block.settings.badge != blank %}<span class="dg-step__label">{{ block.settings.badge | escape }}</span>{% endif -%}
          <h3 class="dg-card__title">{{ block.settings.title | escape }}</h3>
          {%- if block.settings.text != blank %}<div class="dg-card__text">{{ block.settings.text }}</div>{% endif -%}
        </div>
      {%- endfor -%}
    </div>
    {%- if section.settings.button_label != blank -%}
      <div class="dg__cta">
        <a class="dg-btn dg-btn--primary" href="{{ section.settings.button_link | default: routes.all_products_collection_url }}">{{ section.settings.button_label | escape }}{% render 'dg-icon', name: 'arrow' %}</a>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{"name":"Daily Glow steps","tag":"div","class":"section-dg-steps","settings":[{"type":"select","id":"style","label":"Color style","default":"light","options":[{"value":"light","label":"White"},{"value":"mist","label":"Mist"},{"value":"teal","label":"Deep teal"}]},{"type":"text","id":"anchor","label":"Anchor ID (optional)","info":"Lets menus link straight to this section, e.g. /#how-it-works","default":"how-it-works"},{"type":"text","id":"eyebrow","label":"Small label","default":"How it works"},{"type":"inline_richtext","id":"heading","label":"Heading","info":"Italic words get the sunrise gradient.","default":"Three steps. A few minutes a day."},{"type":"richtext","id":"text","label":"Intro text"},{"type":"header","content":"Button"},{"type":"text","id":"button_label","label":"Button label"},{"type":"url","id":"button_link","label":"Button link"},{"type":"header","content":"Spacing"},{"type":"range","id":"padding_top","label":"Top padding","min":0,"max":160,"step":4,"unit":"px","default":88},{"type":"range","id":"padding_bottom","label":"Bottom padding","min":0,"max":160,"step":4,"unit":"px","default":88}],"blocks":[{"type":"step","name":"Step","settings":[{"type":"text","id":"badge","label":"Label (optional)","info":"Replaces the step number with an icon + label, e.g. 'Weeks 1–4'."},{"type":"select","id":"icon","label":"Icon (used with a label)","options":[{"value":"light","label":"Light"},{"value":"hands","label":"Hands"},{"value":"leaf","label":"Leaf"},{"value":"clock","label":"Clock"},{"value":"shield","label":"Shield"},{"value":"home","label":"Home"},{"value":"spark","label":"Spark"},{"value":"truck","label":"Truck"},{"value":"cap","label":"Cap"},{"value":"power","label":"Power"},{"value":"repeat","label":"Repeat"},{"value":"heart","label":"Heart"},{"value":"lock","label":"Lock"},{"value":"mail","label":"Mail"},{"value":"check","label":"Check"}],"default":"clock"},{"type":"text","id":"title","label":"Title","default":"Step"},{"type":"richtext","id":"text","label":"Text"}]}],"presets":[{"name":"Daily Glow steps"}]}
{% endschema %}
