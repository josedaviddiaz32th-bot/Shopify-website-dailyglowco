{%- liquid
  assign sid = section.id
  assign p = section.settings.product
  assign img = section.settings.image
  if img == blank and p != blank
    assign img = p.featured_image
  endif
  if section.settings.button_link != blank
    assign cta_url = section.settings.button_link
  elsif p != blank
    assign cta_url = p.url
  else
    assign cta_url = routes.all_products_collection_url
  endif
  assign img_alt = section.settings.card_title | strip_html | escape
-%}
<style>
  #dgh-{{ sid }} {
    --ink: {{ section.settings.text_color }};
    --bg1: {{ section.settings.bg_1 }};
    --bg2: {{ section.settings.bg_2 }};
    --glow: {{ section.settings.glow_color }};
    --lift: {{ section.settings.float_distance }}px;
    --dur: {{ section.settings.float_speed }}s;
    position: relative; overflow: hidden; isolation: isolate; color: var(--ink);
    background:
      radial-gradient(60% 55% at 50% 42%, {{ section.settings.glow_color | color_modify: 'alpha', 0.30 }} 0%, transparent 70%),
      linear-gradient(160deg, var(--bg1) 0%, var(--bg2) 100%);
  }
  #dgh-{{ sid }} *, #dgh-{{ sid }} *::before, #dgh-{{ sid }} *::after { box-sizing: border-box; }
  #dgh-{{ sid }} .dgh__wrap { max-width: 1240px; margin: 0 auto; padding: {{ section.settings.padding_top }}px 24px {{ section.settings.padding_bottom }}px; }
  #dgh-{{ sid }} .dgh__grid { display: grid; grid-template-columns: minmax(0,1fr) minmax(300px, 520px) minmax(0,1fr); align-items: center; gap: 24px; }
  #dgh-{{ sid }} .dgh__side {
    font-family: var(--font-heading-family); font-weight: 500; color: var(--ink);
    font-size: clamp(26px, 2.9vw, 42px); line-height: 1.15; letter-spacing: -0.01em; margin: 0;
    opacity: 0; animation: dgh-in-{{ sid }} .9s .35s cubic-bezier(.2,.8,.2,1) forwards;
  }
  #dgh-{{ sid }} .dgh__side em { font-style: normal; color: {{ section.settings.accent_color }}; }
  #dgh-{{ sid }} .dgh__side--l { text-align: right; --from: -28px; }
  #dgh-{{ sid }} .dgh__side--r { text-align: left; --from: 28px; }
  #dgh-{{ sid }} .dgh__stage { position: relative; display: grid; place-items: center; min-height: 380px; }
  #dgh-{{ sid }} .dgh__halo {
    position: absolute; inset: 8% 6%; border-radius: 50%; z-index: -1;
    background: radial-gradient(circle, {{ section.settings.glow_color | color_modify: 'alpha', 0.55 }} 0%, {{ section.settings.glow_color | color_modify: 'alpha', 0.12 }} 45%, transparent 70%);
    filter: blur(8px); animation: dgh-pulse-{{ sid }} calc(var(--dur) * 2) ease-in-out infinite;
  }
  #dgh-{{ sid }} .dgh__enter { width: 100%; animation: dgh-rise-{{ sid }} 1.1s cubic-bezier(.2,.8,.2,1) both;{% if section.settings.blend %} mix-blend-mode: multiply;{% endif %} }
  #dgh-{{ sid }} .dgh__float { animation: dgh-float-{{ sid }} var(--dur) ease-in-out infinite; will-change: transform; }
  #dgh-{{ sid }} .dgh__float img {
    display: block; width: 100%; height: auto; max-height: 500px; object-fit: contain;
  }
  #dgh-{{ sid }} .dgh__shadow {
    width: 58%; height: 22px; margin: -6px auto 0; border-radius: 50%;
    background: radial-gradient(closest-side, rgba(23,57,61,.28), transparent);
    animation: dgh-shadow-{{ sid }} var(--dur) ease-in-out infinite;
  }
  #dgh-{{ sid }} .dgh__card {
    position: relative; z-index: 2; max-width: 520px; margin: {{ section.settings.card_offset }}px auto 0; text-align: center;
    padding: 26px 28px 24px; border-radius: 22px; color: #fff;
    background: {{ section.settings.card_color | color_modify: 'alpha', 0.86 }};
    -webkit-backdrop-filter: blur(10px); backdrop-filter: blur(10px);
    box-shadow: 0 24px 50px -24px rgba(23,57,61,.6);
    opacity: 0; animation: dgh-up-{{ sid }} .9s .6s cubic-bezier(.2,.8,.2,1) forwards;
  }
  #dgh-{{ sid }} .dgh__eyebrow { margin: 0 0 6px; font-size: 11px; font-weight: 600; letter-spacing: .24em; text-transform: uppercase; color: #FFC24A; }
  #dgh-{{ sid }} .dgh__title { margin: 0 0 8px; font-family: var(--font-heading-family); font-size: clamp(20px, 2vw, 26px); font-weight: 700; letter-spacing: .02em; color: #fff; }
  #dgh-{{ sid }} .dgh__text { margin: 0 auto 18px; max-width: 400px; font-size: 14.5px; line-height: 1.55; opacity: .88; }
  #dgh-{{ sid }} .dgh__text p { margin: 0; }
  #dgh-{{ sid }} .dgh__row { display: flex; align-items: center; justify-content: center; gap: 18px; flex-wrap: wrap; }
  #dgh-{{ sid }} .dgh__btn {
    display: inline-flex; align-items: center; gap: 10px; min-height: 50px; padding: 0 26px; border-radius: 999px;
    background: linear-gradient(90deg, #F08A2C, #FFC24A); color: #17393D; font-weight: 700; font-size: 15px;
    text-decoration: none; letter-spacing: .02em; box-shadow: 0 10px 26px -12px rgba(240,138,44,.9);
    transition: transform .2s ease, box-shadow .2s ease;
  }
  #dgh-{{ sid }} .dgh__btn:hover { transform: translateY(-2px); box-shadow: 0 16px 32px -14px rgba(240,138,44,1); }
  #dgh-{{ sid }} .dgh__btn svg { width: 18px; height: 18px; }
  #dgh-{{ sid }} .dgh__meta { text-align: left; font-size: 12.5px; line-height: 1.45; }
  #dgh-{{ sid }} .dgh__price { font-size: 17px; font-weight: 700; }
  #dgh-{{ sid }} .dgh__price s { font-weight: 400; opacity: .6; font-size: 13px; margin-left: 4px; }
  #dgh-{{ sid }} .dgh__meta span { opacity: .8; }

  @keyframes dgh-float-{{ sid }} { 0%,100% { transform: translateY(0) rotate(-0.6deg); } 50% { transform: translateY(calc(var(--lift) * -1)) rotate(0.6deg); } }
  @keyframes dgh-shadow-{{ sid }} { 0%,100% { transform: scaleX(1); opacity: 1; } 50% { transform: scaleX(.82); opacity: .6; } }
  @keyframes dgh-pulse-{{ sid }} { 0%,100% { transform: scale(1); opacity: .85; } 50% { transform: scale(1.06); opacity: 1; } }
  @keyframes dgh-rise-{{ sid }} { from { transform: translateY(60px) scale(.94); opacity: 0; } to { transform: none; opacity: 1; } }
  @keyframes dgh-in-{{ sid }} { from { transform: translateX(var(--from)); opacity: 0; } to { transform: none; opacity: 1; } }
  @keyframes dgh-up-{{ sid }} { from { transform: translateY(24px); opacity: 0; } to { transform: none; opacity: 1; } }
  @media (prefers-reduced-motion: reduce) {
    #dgh-{{ sid }} .dgh__float, #dgh-{{ sid }} .dgh__shadow, #dgh-{{ sid }} .dgh__halo, #dgh-{{ sid }} .dgh__enter { animation: none; }
    #dgh-{{ sid }} .dgh__side, #dgh-{{ sid }} .dgh__card { animation: none; opacity: 1; }
  }
  @media screen and (max-width: 749px) {
    #dgh-{{ sid }} .dgh__wrap { padding: {{ section.settings.padding_top | times: 0.45 | round }}px 16px {{ section.settings.padding_bottom | times: 0.6 | round }}px; }
    #dgh-{{ sid }} .dgh__grid { grid-template-columns: 1fr; gap: 6px; }
    #dgh-{{ sid }} .dgh__side { text-align: center; font-size: 26px; position: relative; z-index: 1; }
    #dgh-{{ sid }} .dgh__side--l { order: 1; } #dgh-{{ sid }} .dgh__stage { order: 2; min-height: 0; } #dgh-{{ sid }} .dgh__side--r { order: 3; }
    #dgh-{{ sid }} .dgh__float img { max-height: 340px; }
    #dgh-{{ sid }} .dgh__card { margin-top: 18px; padding: 22px 18px; }
    #dgh-{{ sid }} .dgh__btn { width: 100%; justify-content: center; }
    #dgh-{{ sid }} .dgh__meta { text-align: center; }
  }
</style>

<section id="dgh-{{ sid }}" class="dgh" aria-label="{{ img_alt }}">
  <div class="dgh__wrap">
    <div class="dgh__grid">
      <p class="dgh__side dgh__side--l">{{ section.settings.left_text }}</p>
      <div class="dgh__stage">
        <div class="dgh__halo" aria-hidden="true"></div>
        <div class="dgh__enter">
          <div class="dgh__float">
            {%- if img != blank -%}
              {{ img | image_url: width: 1400 | image_tag: loading: 'eager', fetchpriority: 'high', sizes: '(min-width: 750px) 560px, 90vw', widths: '400, 600, 800, 1000, 1400', alt: img_alt }}
            {%- else -%}
              {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
            {%- endif -%}
          </div>
          <div class="dgh__shadow" aria-hidden="true"></div>
        </div>
      </div>
      <p class="dgh__side dgh__side--r">{{ section.settings.right_text }}</p>
    </div>

    <div class="dgh__card">
      {%- if section.settings.card_eyebrow != blank %}<p class="dgh__eyebrow">{{ section.settings.card_eyebrow | escape }}</p>{% endif -%}
      <h1 class="dgh__title">{{ section.settings.card_title }}</h1>
      {%- if section.settings.card_text != blank %}<div class="dgh__text">{{ section.settings.card_text }}</div>{% endif -%}
      <div class="dgh__row">
        <a class="dgh__btn" href="{{ cta_url }}">{{ section.settings.button_label | escape }}
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
        </a>
        {%- if section.settings.show_price and p != blank -%}
          <div class="dgh__meta">
            <div class="dgh__price">{{ p.price_min | money }}{% if p.compare_at_price_min > p.price_min %}<s>{{ p.compare_at_price_min | money }}</s>{% endif %}</div>
            {%- if section.settings.meta_text != blank %}<span>{{ section.settings.meta_text | escape }}</span>{% endif -%}
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{"name":"Floating product hero","tag":"div","class":"section-dg-hero-float","settings":[
{"type":"header","content":"Product"},
{"type":"product","id":"product","label":"Product"},
{"type":"image_picker","id":"image","label":"Image (optional)","info":"Leave empty to use the product's main photo. A transparent PNG looks best."},
{"type":"checkbox","id":"blend","label":"Blend white photo background into the page","default":true,"info":"Turn off if you upload a transparent PNG or use a dark background."},
{"type":"header","content":"Side text"},
{"type":"inline_richtext","id":"left_text","label":"Left text","default":"Thicker‑looking hair,"},
{"type":"inline_richtext","id":"right_text","label":"Right text","default":"<em>a few minutes</em> a day."},
{"type":"header","content":"Card"},
{"type":"text","id":"card_eyebrow","label":"Small label","default":"Red + near-infrared light"},
{"type":"inline_richtext","id":"card_title","label":"Title","default":"THE HAIR RENEW CAP"},
{"type":"richtext","id":"card_text","label":"Text","default":"<p>Hands-free light therapy for your scalp. No pills, no creams, no appointments.</p>"},
{"type":"text","id":"button_label","label":"Button label","default":"Shop now"},
{"type":"url","id":"button_link","label":"Button link (optional)"},
{"type":"checkbox","id":"show_price","label":"Show price","default":true},
{"type":"text","id":"meta_text","label":"Text under price","default":"30-day money-back guarantee"},
{"type":"range","id":"card_offset","label":"Card position (negative = overlap the product)","min":-100,"max":80,"step":4,"unit":"px","default":24},
{"type":"header","content":"Motion"},
{"type":"range","id":"float_distance","label":"Float height","min":4,"max":40,"step":2,"unit":"px","default":16},
{"type":"range","id":"float_speed","label":"Float speed (seconds per bob)","min":2,"max":10,"step":1,"unit":"s","default":4},
{"type":"header","content":"Colors"},
{"type":"color","id":"bg_1","label":"Background top","default":"#F4F8F6"},
{"type":"color","id":"bg_2","label":"Background bottom","default":"#FDEBDD"},
{"type":"color","id":"glow_color","label":"Glow behind product","default":"#FF6B4A"},
{"type":"color","id":"text_color","label":"Side text","default":"#17393D"},
{"type":"color","id":"accent_color","label":"Highlight color","default":"#E0701C"},
{"type":"color","id":"card_color","label":"Card background","default":"#17393D"},
{"type":"header","content":"Spacing"},
{"type":"range","id":"padding_top","label":"Top padding","min":0,"max":160,"step":4,"unit":"px","default":56},
{"type":"range","id":"padding_bottom","label":"Bottom padding","min":0,"max":160,"step":4,"unit":"px","default":56}
],"presets":[{"name":"Floating product hero"}]}
{% endschema %}
