{{ 'daily-glow.css' | asset_url | stylesheet_tag }}
<section{% if section.settings.anchor != blank %} id="{{ section.settings.anchor | handle }}"{% endif %} class="dg dg--{{ section.settings.style }}" style="--dg-pt: {{ section.settings.padding_top }}px; --dg-pb: {{ section.settings.padding_bottom }}px;">
  <div class="dg__wrap">
    {%- if section.settings.eyebrow != blank or section.settings.heading != blank or section.settings.text != blank -%}
      <div class="dg__head">
        {%- if section.settings.eyebrow != blank %}<p class="dg__eyebrow">{{ section.settings.eyebrow | escape }}</p>{% endif -%}
        {%- if section.settings.heading != blank %}<h2 class="dg__title">{{ section.settings.heading }}</h2>{% endif -%}
        {%- if section.settings.text != blank %}<div class="dg__lede">{{ section.settings.text }}</div>{% endif -%}
      </div>
    {%- endif -%}
    <div class="dg-compare">
      <table>
        <thead><tr>
          <th scope="col"><span class="visually-hidden">Feature</span></th>
          <th scope="col" class="is-us">{{ section.settings.col_us | escape }}</th>
          <th scope="col">{{ section.settings.col_a | escape }}</th>
          <th scope="col">{{ section.settings.col_b | escape }}</th>
        </tr></thead>
        <tbody>
          {%- for block in section.blocks -%}
            <tr {{ block.shopify_attributes }}>
              <td>{{ block.settings.label | escape }}</td>
              {%- assign vals = block.settings.us | append: ',' | append: block.settings.a | append: ',' | append: block.settings.b | split: ',' -%}
              {%- for v in vals -%}
                <td{% if forloop.first %} class="is-us"{% endif %}>
                  {%- if v == 'true' -%}<span class="dg-yes" role="img" aria-label="Yes">{% render 'dg-icon', name: 'check' %}</span>
                  {%- else -%}<span class="dg-no" role="img" aria-label="No">{% render 'dg-icon', name: 'x' %}</span>{%- endif -%}
                </td>
              {%- endfor -%}
            </tr>
          {%- endfor -%}
        </tbody>
      </table>
    </div>
    {%- if section.settings.note != blank %}<p class="dg__note">{{ section.settings.note | escape }}</p>{% endif -%}
    {%- if section.settings.button_label != blank -%}
      <div class="dg__cta">
        <a class="dg-btn dg-btn--primary" href="{{ section.settings.button_link | default: routes.all_products_collection_url }}">{{ section.settings.button_label | escape }}{% render 'dg-icon', name: 'arrow' %}</a>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{"name":"Daily Glow comparison","tag":"div","class":"section-dg-compare","settings":[{"type":"select","id":"style","label":"Color style","default":"mist","options":[{"value":"light","label":"White"},{"value":"mist","label":"Mist"},{"value":"teal","label":"Deep teal"}]},{"type":"text","id":"anchor","label":"Anchor ID (optional)","info":"Lets menus link straight to this section, e.g. /#how-it-works"},{"type":"text","id":"eyebrow","label":"Small label","default":"Compare"},{"type":"inline_richtext","id":"heading","label":"Heading","info":"Italic words get the sunrise gradient.","default":"Why an at-home <em>light cap</em>?"},{"type":"richtext","id":"text","label":"Intro text"},{"type":"text","id":"col_us","label":"Your column","default":"Glow Cap"},{"type":"text","id":"col_a","label":"Column 2","default":"In-clinic light sessions"},{"type":"text","id":"col_b","label":"Column 3","default":"Pills & supplements"},{"type":"text","id":"note","label":"Footnote"},{"type":"header","content":"Button"},{"type":"text","id":"button_label","label":"Button label"},{"type":"url","id":"button_link","label":"Button link"},{"type":"header","content":"Spacing"},{"type":"range","id":"padding_top","label":"Top padding","min":0,"max":160,"step":4,"unit":"px","default":88},{"type":"range","id":"padding_bottom","label":"Bottom padding","min":0,"max":160,"step":4,"unit":"px","default":88}],"blocks":[{"type":"row","name":"Row","settings":[{"type":"text","id":"label","label":"Feature","default":"Feature"},{"type":"checkbox","id":"us","label":"Your column","default":true},{"type":"checkbox","id":"a","label":"Column 2","default":false},{"type":"checkbox","id":"b","label":"Column 3","default":false}]}],"presets":[{"name":"Daily Glow comparison"}]}
{% endschema %}
