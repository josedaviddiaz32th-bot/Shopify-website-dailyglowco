{%- comment -%}
  Daily Glow hero banner — The Daily Glow Co.
  Every text, link, color and image is editable in Online Store → Customize.
{%- endcomment -%}

{%- liquid
  assign sid = section.id
  assign hero_product = section.settings.product
  if section.settings.button_link != blank
    assign primary_url = section.settings.button_link
  elsif hero_product != blank
    assign primary_url = hero_product.url
  else
    assign primary_url = routes.all_products_collection_url
  endif
  assign hero_image = section.settings.image
  if hero_image == blank and hero_product != blank and section.settings.use_product_image
    assign hero_image = hero_product.featured_image
  endif
-%}

<style>
  #dg-{{ sid }} {
    --dg-bg: {{ section.settings.bg_color }};
    --dg-text: {{ section.settings.text_color }};
    --dg-accent: {{ section.settings.accent_color }};
    --dg-accent-2: {{ section.settings.accent_color_2 }};
    position: relative;
    overflow: hidden;
    background: var(--dg-bg);
    color: var(--dg-text);
    isolation: isolate;
  }
  #dg-{{ sid }} .dg-glow {
    position: absolute; z-index: -1; pointer-events: none;
    width: 70vmax; height: 70vmax; right: -18vmax; top: -30vmax;
    background: radial-gradient(circle, {{ section.settings.accent_color_2 | color_modify: 'alpha', 0.45 }} 0%, {{ section.settings.accent_color | color_modify: 'alpha', 0.18 }} 35%, transparent 65%);
    animation: dg-breathe-{{ sid }} 7s ease-in-out infinite;
  }
  #dg-{{ sid }} .dg-ridge {
    position: absolute; left: 0; right: 0; bottom: -1px; z-index: -1; width: 100%; height: auto;
    color: var(--dg-text); opacity: .06; pointer-events: none;
  }
  #dg-{{ sid }} .dg-inner {
    max-width: 1240px; margin: 0 auto;
    padding: {{ section.settings.padding_top }}px 24px {{ section.settings.padding_bottom }}px;
    display: grid; grid-template-columns: 1.1fr .9fr; gap: 48px; align-items: center;
  }
  #dg-{{ sid }} .dg-kicker {
    display: inline-flex; align-items: center; gap: 10px;
    font-size: 12px; font-weight: 600; letter-spacing: .28em; text-transform: uppercase;
    color: var(--dg-accent-2); margin: 0 0 18px;
  }
  #dg-{{ sid }} .dg-kicker::before {
    content: ""; width: 28px; height: 2px; border-radius: 2px;
    background: linear-gradient(90deg, var(--dg-accent), var(--dg-accent-2));
  }
  #dg-{{ sid }} .dg-heading {
    font-size: clamp(34px, 5.2vw, 62px); line-height: 1.05; letter-spacing: -0.02em;
    margin: 0 0 20px; color: var(--dg-text); font-weight: 700;
  }
  #dg-{{ sid }} .dg-heading em {
    font-style: normal;
    background: linear-gradient(90deg, var(--dg-accent), var(--dg-accent-2));
    -webkit-background-clip: text; background-clip: text; color: transparent;
  }
  #dg-{{ sid }} .dg-sub {
    font-size: clamp(16px, 1.4vw, 19px); line-height: 1.6; max-width: 34em;
    margin: 0 0 32px; color: var(--dg-text); opacity: .82;
  }
  #dg-{{ sid }} .dg-sub p { margin: 0; }
  #dg-{{ sid }} .dg-ctas { display: flex; flex-wrap: wrap; gap: 14px; align-items: center; }
  #dg-{{ sid }} .dg-btn {
    display: inline-flex; align-items: center; justify-content: center; gap: 10px;
    min-height: 52px; padding: 0 28px; border-radius: 999px;
    font-size: 16px; font-weight: 600; text-decoration: none; letter-spacing: .01em;
    transition: transform .2s ease, box-shadow .2s ease, background-color .2s ease;
  }
  #dg-{{ sid }} .dg-btn--primary {
    background: linear-gradient(90deg, var(--dg-accent), var(--dg-accent-2));
    color: {{ section.settings.bg_color }};
    box-shadow: 0 10px 30px -10px {{ section.settings.accent_color | color_modify: 'alpha', 0.7 }};
  }
  #dg-{{ sid }} .dg-btn--primary:hover { transform: translateY(-2px); box-shadow: 0 16px 36px -12px {{ section.settings.accent_color | color_modify: 'alpha', 0.85 }}; }
  #dg-{{ sid }} .dg-btn--ghost {
    color: var(--dg-text); border: 1.5px solid {{ section.settings.text_color | color_modify: 'alpha', 0.35 }};
  }
  #dg-{{ sid }} .dg-btn--ghost:hover { background: {{ section.settings.text_color | color_modify: 'alpha', 0.08 }}; }
  #dg-{{ sid }} .dg-btn svg { width: 18px; height: 18px; }
  #dg-{{ sid }} .dg-price { font-size: 14px; opacity: .75; margin: 14px 0 0; }
  #dg-{{ sid }} .dg-trust {
    list-style: none; padding: 0; margin: 36px 0 0;
    display: flex; flex-wrap: wrap; gap: 12px 26px; font-size: 14px;
  }
  #dg-{{ sid }} .dg-trust li { display: inline-flex; align-items: center; gap: 8px; opacity: .9; }
  #dg-{{ sid }} .dg-trust svg { width: 18px; height: 18px; color: var(--dg-accent-2); flex: none; }
  #dg-{{ sid }} .dg-media { position: relative; display: flex; justify-content: center; }
  #dg-{{ sid }} .dg-media img {
    width: 100%; max-width: 520px; height: auto; display: block;
    border-radius: 28px; object-fit: cover; aspect-ratio: 1 / 1;
    box-shadow: 0 30px 60px -30px rgba(0,0,0,.55);
  }
  #dg-{{ sid }} .dg-art { width: 100%; max-width: 480px; height: auto; }
  #dg-{{ sid }} .dg-art .dg-sun { animation: dg-rise-{{ sid }} 1.6s cubic-bezier(.2,.8,.2,1) both; transform-origin: center; }
  @keyframes dg-breathe-{{ sid }} { 0%,100% { transform: scale(1); opacity: .9; } 50% { transform: scale(1.06); opacity: 1; } }
  @keyframes dg-rise-{{ sid }} { from { transform: translateY(40px); opacity: 0; } to { transform: none; opacity: 1; } }
  @media (prefers-reduced-motion: reduce) {
    #dg-{{ sid }} .dg-glow, #dg-{{ sid }} .dg-art .dg-sun { animation: none; }
    #dg-{{ sid }} .dg-btn { transition: none; }
  }
  @media screen and (max-width: 749px) {
    #dg-{{ sid }} .dg-inner {
      grid-template-columns: 1fr; gap: 28px; text-align: left;
      padding: {{ section.settings.padding_top | times: 0.6 | round }}px 18px {{ section.settings.padding_bottom | times: 0.6 | round }}px;
    }
    #dg-{{ sid }} .dg-media { order: {% if section.settings.mobile_media_first %}-1{% else %}1{% endif %}; }
    #dg-{{ sid }} .dg-art, #dg-{{ sid }} .dg-media img { max-width: 360px; }
    #dg-{{ sid }} .dg-btn { width: 100%; }
    #dg-{{ sid }} .dg-glow { right: -40vmax; top: -35vmax; }
  }
</style>

<section id="dg-{{ sid }}" class="dg-banner" aria-label="{{ section.settings.heading | strip_html | escape }}">
  <div class="dg-glow" aria-hidden="true"></div>
  <svg class="dg-ridge" viewBox="0 0 1440 220" preserveAspectRatio="none" aria-hidden="true">
    <path fill="currentColor" d="M0 220 L0 150 L180 70 L300 130 L470 30 L640 140 L760 90 L930 170 L1110 60 L1260 120 L1440 50 L1440 220 Z"/>
  </svg>

  <div class="dg-inner">
    <div class="dg-copy">
      {%- if section.settings.kicker != blank -%}
        <p class="dg-kicker">{{ section.settings.kicker | escape }}</p>
      {%- endif -%}
      <h1 class="dg-heading">{{ section.settings.heading }}</h1>
      {%- if section.settings.subheading != blank -%}
        <div class="dg-sub">{{ section.settings.subheading }}</div>
      {%- endif -%}

      <div class="dg-ctas">
        {%- if section.settings.button_label != blank -%}
          <a class="dg-btn dg-btn--primary" href="{{ primary_url }}">
            {{ section.settings.button_label | escape }}
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
          </a>
        {%- endif -%}
        {%- if section.settings.button_2_label != blank -%}
          <a class="dg-btn dg-btn--ghost" href="{{ section.settings.button_2_link | default: routes.all_products_collection_url }}">
            {{ section.settings.button_2_label | escape }}
          </a>
        {%- endif -%}
      </div>

      {%- if section.settings.show_price and hero_product != blank -%}
        <p class="dg-price">
          {%- if hero_product.price_varies -%}From {% endif -%}
          {{ hero_product.price_min | money }}
          {%- if hero_product.compare_at_price_min > hero_product.price_min %} · <s>{{ hero_product.compare_at_price_min | money }}</s>{% endif -%}
        </p>
      {%- endif -%}

      {%- liquid
        assign t1 = section.settings.trust_1
        assign t2 = section.settings.trust_2
        assign t3 = section.settings.trust_3
      -%}
      {%- if t1 != blank or t2 != blank or t3 != blank -%}
        <ul class="dg-trust">
          {%- for t in (1..3) -%}
            {%- case t -%}
              {%- when 1 -%}{%- assign label = t1 -%}
              {%- when 2 -%}{%- assign label = t2 -%}
              {%- when 3 -%}{%- assign label = t3 -%}
            {%- endcase -%}
            {%- if label != blank -%}
              <li>
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10" opacity=".35"/><path d="M7.5 12.5l3 3 6-6.5"/></svg>
                {{ label | escape }}
              </li>
            {%- endif -%}
          {%- endfor -%}
        </ul>
      {%- endif -%}
    </div>

    <div class="dg-media">
      {%- if hero_image != blank -%}
        {{ hero_image | image_url: width: 1200 | image_tag: loading: 'eager', fetchpriority: 'high', sizes: '(min-width: 750px) 45vw, 90vw', widths: '400, 600, 800, 1000, 1200', alt: hero_image.alt | default: section.settings.heading | strip_html }}
      {%- else -%}
        <svg class="dg-art" viewBox="0 0 400 400" role="img" aria-label="A sun rising behind two mountain peaks">
          <defs>
            <linearGradient id="dg-sun-{{ sid }}" x1="0" y1="1" x2="0" y2="0">
              <stop offset="0" stop-color="{{ section.settings.accent_color }}"/>
              <stop offset="1" stop-color="{{ section.settings.accent_color_2 }}"/>
            </linearGradient>
            <radialGradient id="dg-halo-{{ sid }}">
              <stop offset="0" stop-color="{{ section.settings.accent_color_2 }}" stop-opacity=".55"/>
              <stop offset="1" stop-color="{{ section.settings.accent_color_2 }}" stop-opacity="0"/>
            </radialGradient>
          </defs>
          <circle cx="240" cy="160" r="150" fill="url(#dg-halo-{{ sid }})"/>
          <g class="dg-sun"><circle cx="240" cy="160" r="64" fill="url(#dg-sun-{{ sid }})"/></g>
          <path d="M24 328 L144 160 L200 232 L252 176 L376 328 Z" fill="{{ section.settings.text_color }}" stroke="{{ section.settings.text_color }}" stroke-width="16" stroke-linejoin="round"/>
          <path d="M144 160 L113 203 L130 197 L144 210 L158 195 L174 202 Z" fill="{{ section.settings.bg_color }}" opacity=".25"/>
          <rect x="60" y="352" width="280" height="10" rx="5" fill="{{ section.settings.text_color }}" opacity=".25"/>
        </svg>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Daily Glow banner",
  "tag": "div",
  "class": "section-daily-glow-banner",
  "settings": [
    { "type": "header", "content": "Text" },
    { "type": "text", "id": "kicker", "label": "Small label above heading", "default": "The Daily Glow Co." },
    { "type": "inline_richtext", "id": "heading", "label": "Heading", "info": "Wrap words in italics to give them the sunrise gradient.", "default": "Tools for a <em>healthier life</em>, every day." },
    { "type": "richtext", "id": "subheading", "label": "Subheading", "default": "<p>Simple wellness tools you use at home — no pills, no supplements. Just easy daily rituals that help you look and feel your best.</p>" },
    { "type": "header", "content": "Featured product" },
    { "type": "product", "id": "product", "label": "Hero product", "info": "The main button links here unless you set a custom link below." },
    { "type": "checkbox", "id": "show_price", "label": "Show product price", "default": true },
    { "type": "checkbox", "id": "use_product_image", "label": "Use product image when no banner image is set", "default": true },
    { "type": "header", "content": "Buttons" },
    { "type": "text", "id": "button_label", "label": "Main button label", "default": "Shop the Red Light Cap" },
    { "type": "url", "id": "button_link", "label": "Main button link (optional)" },
    { "type": "text", "id": "button_2_label", "label": "Second button label", "default": "Explore all tools" },
    { "type": "url", "id": "button_2_link", "label": "Second button link" },
    { "type": "header", "content": "Trust points" },
    { "type": "text", "id": "trust_1", "label": "Point 1", "default": "Drug-free & non-invasive" },
    { "type": "text", "id": "trust_2", "label": "Point 2", "default": "Easy at-home routine" },
    { "type": "text", "id": "trust_3", "label": "Point 3", "default": "Secure checkout" },
    { "type": "header", "content": "Image" },
    { "type": "image_picker", "id": "image", "label": "Banner image", "info": "Square images work best. Leave empty to show the sunrise illustration." },
    { "type": "checkbox", "id": "mobile_media_first", "label": "Show image above text on mobile", "default": false },
    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#17393D" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#FFFFFF" },
    { "type": "color", "id": "accent_color", "label": "Accent (sunrise orange)", "default": "#F08A2C" },
    { "type": "color", "id": "accent_color_2", "label": "Accent 2 (golden glow)", "default": "#FFC24A" },
    { "type": "header", "content": "Spacing" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 24, "max": 160, "step": 4, "unit": "px", "default": 96 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 24, "max": 160, "step": 4, "unit": "px", "default": 104 }
  ],
  "presets": [ { "name": "Daily Glow banner" } ]
}
{% endschema %}
