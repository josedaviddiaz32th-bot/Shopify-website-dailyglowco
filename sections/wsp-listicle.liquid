{%- comment -%}
  Listicle landing page ("N reasons why…") for ad traffic: a labelled advertisement
  with an intro and numbered reasons, each with an optional image. Pair it with a
  wsp-hero section below it so the reader can buy on the same page.
{%- endcomment -%}
{{ 'daily-glow.css' | asset_url | stylesheet_tag }}
{{ 'wsp.css' | asset_url | stylesheet_tag }}

<section class="dg dg--white wsp-lst" style="--dg-pt: {{ section.settings.padding_top }}px; --dg-pb: {{ section.settings.padding_bottom }}px;">
  <div class="dg__wrap wsp-lst__wrap">
    {%- if section.settings.label != blank %}<p class="wsp-lst__label">{{ section.settings.label | escape }}</p>{% endif -%}
    {%- if section.settings.heading != blank %}<h1 class="wsp-lst__title">{{ section.settings.heading }}</h1>{% endif -%}
    {%- if section.settings.intro != blank %}<div class="wsp-lst__intro">{{ section.settings.intro }}</div>{% endif -%}

    <ol class="wsp-lst__list">
      {%- for block in section.blocks -%}
        <li class="wsp-lst__item" {{ block.shopify_attributes }}>
          <h2 class="wsp-lst__h"><span class="wsp-lst__n">{{ forloop.index }}.</span> {{ block.settings.title }}</h2>
          {%- if block.settings.image != blank -%}
            {{ block.settings.image | image_url: width: 1200 | image_tag: class: 'wsp-lst__img', loading: 'lazy', widths: '400, 600, 900, 1200', sizes: '(min-width: 750px) 680px, 92vw', alt: block.settings.alt | default: block.settings.image.alt | escape }}
          {%- endif -%}
          {%- if block.settings.text != blank %}<div class="wsp-lst__text">{{ block.settings.text }}</div>{% endif -%}
        </li>
      {%- endfor -%}
    </ol>

    {%- if section.settings.cta_label != blank -%}
      <a class="dg-btn dg-btn--primary wsp-lst__cta" href="{{ section.settings.cta_link | default: '#offer' }}">{{ section.settings.cta_label | escape }} →</a>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "WSP listicle",
  "tag": "section",
  "class": "section-wsp-listicle",
  "settings": [
    { "type": "text", "id": "label", "label": "Label above the headline", "default": "Advertisement", "info": "Keep a label like 'Advertisement' so the page isn't mistaken for news (FTC)." },
    { "type": "inline_richtext", "id": "heading", "label": "Headline" },
    { "type": "richtext", "id": "intro", "label": "Intro" },
    { "type": "text", "id": "cta_label", "label": "Button under the list", "default": "See the set" },
    { "type": "text", "id": "cta_link", "label": "Button link", "default": "#offer", "info": "#offer jumps to the buy box on this page." },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 32 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 48 }
  ],
  "blocks": [
    { "type": "reason", "name": "Reason", "settings": [
      { "type": "text", "id": "title", "label": "Title" },
      { "type": "image_picker", "id": "image", "label": "Image" },
      { "type": "text", "id": "alt", "label": "Image description" },
      { "type": "richtext", "id": "text", "label": "Text" }
    ] }
  ],
  "presets": [{ "name": "WSP listicle" }]
}
{% endschema %}
