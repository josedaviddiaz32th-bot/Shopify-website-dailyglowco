{% comment %}
  The Daily Glow Co. cart drawer.
  Layout: header (My cart • N) · free-shipping tracker · line items (image, name, deal tag,
  stepper | was / now / save, remove) · add-a-second-cap offer · "Special offers" row ·
  footer (collapsible discount code, one checkout button with the total, payment icons).
  Shipping and discount totals are left to checkout to keep the footer short.

  Keeps the Dawn hooks cart.js / cart-drawer.js rely on:
  cart-drawer-items, #CartDrawer-Item-N, #Drawer-quantity-N, cart-remove-button[data-index],
  #CartDrawer-LineItemError-N, .loading__spinner, #CartDrawer-CartItems, .cart-drawer__footer.
  Offer "Add to cart", the offer arrows and the discount field are handled in dg-theme.js.
{% endcomment %}

{{ 'quantity-popover.css' | asset_url | stylesheet_tag }}

<script src="{{ 'cart.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'quantity-popover.js' | asset_url }}" defer="defer"></script>

<style>
  .drawer {
    visibility: hidden;
  }
</style>

{%- liquid
  assign dg_pct = settings.bundle_discount_percent | default: 0
  assign dg_free_ship = settings.free_shipping_threshold | default: 40 | times: 100
  assign dg_in_cart = cart.items | map: 'product_id' | join: ','
  assign dg_in_cart = ',' | append: dg_in_cart | append: ','
-%}

<cart-drawer class="drawer dgc{% if cart == empty %} is-empty{% endif %}">
  <div id="CartDrawer" class="cart-drawer">
    <div id="CartDrawer-Overlay" class="cart-drawer__overlay"></div>
    <div
      class="drawer__inner dgc__inner"
      role="dialog"
      aria-modal="true"
      aria-label="{{ 'sections.cart.title' | t }}"
      tabindex="-1"
    >
      {%- if cart == empty -%}
        <div class="drawer__inner-empty dgc-empty">
          <button
            class="drawer__close dgc__close"
            type="button"
            onclick="this.closest('cart-drawer').close()"
            aria-label="{{ 'accessibility.close' | t }}"
          >
            {% render 'dg-icon', name: 'x' %}
          </button>
          <div class="dgc-empty__body">
            <h2 class="dgc-empty__title">Your cart is empty</h2>
            <p class="dgc-empty__text">Soft, reusable patches for smoother-looking mornings.</p>
            <a href="/pages/products" class="dgc-btn">Start shopping</a>
          </div>
        </div>
      {%- endif -%}

      <div class="drawer__header dgc-head">
        <h2 class="drawer__heading dgc-head__title">My cart <span aria-hidden="true">•</span> {{ cart.item_count }}</h2>
        <button
          class="drawer__close dgc__close"
          type="button"
          onclick="this.closest('cart-drawer').close()"
          aria-label="{{ 'accessibility.close' | t }}"
        >
          {% render 'dg-icon', name: 'x' %}
        </button>
      </div>

      <cart-drawer-items
        class="dgc-scroll{% if cart == empty %} is-empty{% endif %}"
        view-event-payload="{{ cart | standard_event_data: 'view', context: 'dialog' | escape }}"
        view-event-trigger="manual"
      >
        {%- if cart != empty -%}
          {%- liquid
            assign dg_cap_count = 0
            for item in cart.items
              if item.product.handle == 'glow-cap'
                assign dg_cap_count = dg_cap_count | plus: item.quantity
              endif
            endfor
            assign dg_ship_left = dg_free_ship | minus: cart.total_price
            assign dg_ship_pct = cart.total_price | times: 100 | divided_by: dg_free_ship
          -%}
          <div class="dgc-rewards">
            {%- if dg_ship_left > 0 -%}
              <p class="dgc-rewards__msg">{% render 'dg-icon', name: 'truck' %}<span>You're <strong>{{ dg_ship_left | money }}</strong> away from <strong>free shipping</strong></span></p>
              <div class="dgc-rewards__track"><span style="width: {{ dg_ship_pct }}%"></span></div>
            {%- elsif dg_pct > 0 and dg_cap_count == 1 -%}
              <p class="dgc-rewards__msg">{% render 'dg-icon', name: 'truck' %}<span>You've unlocked <strong>free shipping</strong>. Add <strong>1 more cap</strong> to save <strong>{{ dg_pct }}%</strong> on both</span></p>
              <div class="dgc-rewards__track"><span style="width: 100%"></span></div>
            {%- else -%}
              <p class="dgc-rewards__msg">{% render 'dg-icon', name: 'truck' %}<span>You've unlocked <strong>free shipping</strong></span></p>
              <div class="dgc-rewards__track"><span style="width: 100%"></span></div>
            {%- endif -%}
          </div>
        {%- endif -%}

        <form action="{{ routes.cart_url }}" id="CartDrawer-Form" class="cart__contents cart-drawer__form" method="post">
          <div id="CartDrawer-CartItems" class="drawer__contents js-contents">
            {%- if cart != empty -%}
              <ul class="dgc-items" role="list">
                {%- for item in cart.items -%}
                  {%- liquid
                    assign dg_img = item.image | default: item.product.featured_image
                    assign dg_base = item.variant.compare_at_price | default: 0
                    if item.original_price > dg_base
                      assign dg_base = item.original_price
                    endif
                    assign dg_line_cmp = dg_base | times: item.quantity
                    assign dg_line_save = dg_line_cmp | minus: item.final_line_price
                  -%}
                  <li id="CartDrawer-Item-{{ item.index | plus: 1 }}" class="cart-item dgc-item">
                    <a href="{{ item.url }}" class="dgc-item__media" tabindex="-1" aria-hidden="true">
                      {%- if dg_img -%}
                        <img src="{{ dg_img | image_url: width: 240 }}" alt="" loading="lazy" width="120" height="120">
                      {%- endif -%}
                    </a>

                    <div class="dgc-item__body">
                      <a href="{{ item.url }}" class="cart-item__name dgc-item__name">{{ item.product.title | escape }}</a>

                      {%- if item.product.variants.size > 1 -%}
                        <p class="dgc-item__variant">
                          {%- for option in item.options_with_values -%}
                            {{ option.value }}{% unless forloop.last %} · {% endunless %}
                          {%- endfor -%}
                        </p>
                      {%- endif -%}

                      {%- for property in item.properties -%}
                        {%- assign p_first = property.first | slice: 0 -%}
                        {%- if property.last != blank and p_first != '_' -%}
                          <p class="dgc-item__variant">{{ property.first }}: {{ property.last }}</p>
                        {%- endif -%}
                      {%- endfor -%}

                      {%- for discount in item.line_level_discount_allocations -%}
                        <span class="dgc-tag">{% render 'dg-icon', name: 'tag' %}<span>{{ discount.discount_application.title | escape }}</span></span>
                      {%- endfor -%}

                      <quantity-input class="quantity cart-quantity dgc-qty">
                        <button class="quantity__button" name="minus" type="button">
                          <span class="visually-hidden">{{ 'products.product.quantity.decrease' | t: product: item.product.title | escape }}</span>
                          <span aria-hidden="true">&minus;</span>
                        </button>
                        <input
                          class="quantity__input"
                          type="number"
                          data-quantity-variant-id="{{ item.variant.id }}"
                          data-quantity-line-key="{{ item.key }}"
                          name="updates[]"
                          value="{{ item.quantity }}"
                          {% # theme-check-disable %}
                          data-cart-quantity="{{ cart | item_count_for_variant: item.variant.id }}"
                          min="0"
                          data-min="{{ item.variant.quantity_rule.min }}"
                          {% if item.variant.quantity_rule.max != null %}max="{{ item.variant.quantity_rule.max }}"{% endif %}
                          step="{{ item.variant.quantity_rule.increment }}"
                          {% # theme-check-enable %}
                          aria-label="{{ 'products.product.quantity.input_label' | t: product: item.product.title | escape }}"
                          id="Drawer-quantity-{{ item.index | plus: 1 }}"
                          data-index="{{ item.index | plus: 1 }}"
                        >
                        <button class="quantity__button" name="plus" type="button">
                          <span class="visually-hidden">{{ 'products.product.quantity.increase' | t: product: item.product.title | escape }}</span>
                          <span aria-hidden="true">+</span>
                        </button>
                      </quantity-input>

                      <div id="CartDrawer-LineItemError-{{ item.index | plus: 1 }}" class="cart-item__error dgc-item__error" role="alert">
                        <small class="cart-item__error-text"></small>
                      </div>
                    </div>

                    <div class="dgc-item__side">
                      <div class="dgc-item__price cart-item__totals">
                        {%- render 'loading-spinner' -%}
                        {%- if dg_line_save > 0 -%}<s>{{ dg_line_cmp | money }}</s>{%- endif -%}
                        <strong>{{ item.final_line_price | money }}</strong>
                      </div>
                      {%- if dg_line_save > 0 -%}
                        <span class="dgc-item__save">{% render 'dg-icon', name: 'tag' %}<span>Save {{ dg_line_save | money_without_trailing_zeros }}</span></span>
                      {%- endif -%}
                      <cart-remove-button id="CartDrawer-Remove-{{ item.index | plus: 1 }}" data-index="{{ item.index | plus: 1 }}">
                        <button type="button" class="dgc-item__remove" aria-label="{{ 'sections.cart.remove_title' | t: title: item.title | escape }}">
                          {% render 'dg-icon', name: 'trash' %}
                        </button>
                      </cart-remove-button>
                    </div>
                  </li>
                {%- endfor -%}
              </ul>

              {%- comment -%} Add a second cap (only when a single cap is the whole cart) {%- endcomment -%}
              {%- assign dg_line = cart.items | first -%}
              {%- if dg_pct > 0 and cart.items.size == 1 and cart.item_count == 1 and dg_line.product.handle == 'glow-cap' -%}
                {%- assign dg_keep = 100 | minus: dg_pct -%}
                {%- assign dg_duo = dg_line.final_price | times: 2 | times: dg_keep | divided_by: 100 -%}
                <div class="dgc-offer">
                  <span class="dgc-offer__tag">Most popular</span>
                  <div class="dgc-offer__row">
                    <div class="dgc-offer__media">
                      {%- assign dg_oimg = dg_line.image | default: dg_line.product.featured_image -%}
                      {%- if dg_oimg -%}<img src="{{ dg_oimg | image_url: width: 160 }}" alt="" loading="lazy" width="64" height="64">{%- endif -%}
                      <span class="dgc-offer__x2">×2</span>
                    </div>
                    <div class="dgc-offer__copy">
                      <span class="dgc-offer__title">Make it a pair, save {{ dg_pct }}%</span>
                      <span class="dgc-offer__text">One for you, one for someone you share your routine with. {{ dg_duo | money }} for both.</span>
                    </div>
                  </div>
                  <button type="button" class="dgc-offer__btn" data-dg-upsell data-line="1" data-variant="{{ dg_line.variant_id }}">
                    Add a second cap
                  </button>
                </div>
              {%- endif -%}

              {%- comment -%} Special offers: other products from the theme setting, skipping what's in the cart. {%- endcomment -%}
              {%- capture dg_offer_cards -%}
                {%- for op in settings.dg_cart_offers -%}
                  {%- liquid
                    assign op_key = ',' | append: op.id | append: ','
                    if dg_in_cart contains op_key
                      continue
                    endif
                    assign ov = op.selected_or_first_available_variant
                    unless ov.available
                      continue
                    endunless
                    assign o_img = ov.image | default: op.featured_image
                    assign o_save = 0
                    if ov.compare_at_price > ov.price
                      assign o_save = ov.compare_at_price | minus: ov.price | times: 100.0 | divided_by: ov.compare_at_price | round
                    endif
                  -%}
                  <li class="dgc-offers__card">
                    <a href="{{ op.url }}" class="dgc-offers__media" tabindex="-1" aria-hidden="true">
                      {%- if o_img -%}<img src="{{ o_img | image_url: width: 160 }}" alt="" loading="eager" width="80" height="80">{%- endif -%}
                    </a>
                    <div class="dgc-offers__body">
                      <a href="{{ op.url }}" class="dgc-offers__name">{{ op.title | escape }}</a>
                      <p class="dgc-offers__price">
                        <strong>{{ ov.price | money }}</strong>
                        {%- if o_save > 0 -%}
                          <s>{{ ov.compare_at_price | money }}</s>
                          <span class="dgc-offers__save">Save {{ o_save }}%</span>
                        {%- endif -%}
                      </p>
                    </div>
                    <button type="button" class="dgc-offers__add" data-dgc-add="{{ ov.id }}">Add</button>
                  </li>
                {%- endfor -%}
              {%- endcapture -%}
              {%- if dg_offer_cards contains 'dgc-offers__card' -%}
                <div class="dgc-offers" data-dgc-offers>
                  <div class="dgc-offers__head">
                    <h3 class="dgc-offers__title">{{ settings.dg_cart_offers_title | default: 'Special offers for your order' | escape }}</h3>
                    <div class="dgc-offers__nav">
                      <button type="button" class="dgc-offers__arrow" data-dgc-step="-1" aria-label="Previous offer" disabled>{% render 'dg-icon', name: 'chevron-left' %}</button>
                      <button type="button" class="dgc-offers__arrow" data-dgc-step="1" aria-label="Next offer">{% render 'dg-icon', name: 'chevron-right' %}</button>
                    </div>
                  </div>
                  <ul class="dgc-offers__track" role="list" data-dgc-track>{{ dg_offer_cards }}</ul>
                </div>
              {%- endif -%}
            {%- endif -%}
            <p id="CartDrawer-LiveRegionText" class="visually-hidden" role="status"></p>
            <p id="CartDrawer-LineItemStatus" class="visually-hidden" aria-hidden="true" role="status">
              {{ 'accessibility.loading' | t }}
            </p>
          </div>
          <div id="CartDrawer-CartErrors" role="alert"></div>
        </form>
      </cart-drawer-items>

      <div class="drawer__footer dgc-foot">
        <div class="cart-drawer__footer">
          {%- if settings.dg_cart_discount_field -%}
            {%- assign dg_codes = cart.discount_applications | where: 'type', 'discount_code' -%}
            <details class="dgc-code" data-dgc-code{% if dg_codes.size > 0 %} open{% endif %}>
              <summary class="dgc-code__toggle">{% render 'dg-icon', name: 'tag' %}<span>Have a discount code?</span></summary>
              <div class="dgc-code__row">
                <input type="text" class="dgc-code__input" placeholder="Discount code" aria-label="Discount code" autocomplete="off" autocapitalize="characters" data-dgc-code-input>
                <button type="button" class="dgc-code__apply" data-dgc-code-apply>Apply</button>
              </div>
              {%- if dg_codes.size > 0 -%}
                <ul class="dgc-code__list" role="list">
                  {%- for dc in dg_codes -%}
                    <li>
                      {% render 'dg-icon', name: 'tag' %}<span>{{ dc.title | upcase | escape }}</span>
                      <button type="button" data-dgc-code-remove="{{ dc.title | escape }}" aria-label="Remove {{ dc.title | escape }}">{% render 'dg-icon', name: 'x' %}</button>
                    </li>
                  {%- endfor -%}
                </ul>
              {%- endif -%}
              <p class="dgc-code__msg" data-dgc-code-msg role="status"></p>
            </details>
          {%- endif -%}
          <p class="visually-hidden totals" role="status">Subtotal {{ cart.total_price | money }}</p>
        </div>

        <div class="cart__ctas dgc-foot__ctas">
          <button
            type="submit"
            id="CartDrawer-Checkout"
            class="cart__checkout-button dgc-btn dgc-btn--checkout"
            name="checkout"
            form="CartDrawer-Form"
            {% if cart == empty %}disabled{% endif %}
          >
            {% render 'dg-icon', name: 'lock' %}
            <span>Checkout · {{ cart.total_price | money }}</span>
          </button>
          <ul class="dgc-pay" role="list" aria-label="Payment methods">
            {%- for type in shop.enabled_payment_types -%}
              <li>{{ type | payment_type_svg_tag: class: 'dgc-pay__icon' }}</li>
            {%- endfor -%}
          </ul>
        </div>
      </div>
    </div>
  </div>
</cart-drawer>
