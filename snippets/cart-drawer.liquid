{% comment %}
  The Daily Glow Co. cart drawer (rebuilt).
  Layout: header · rewards bar · item cards · add-a-second-cap offer · trust row · compact footer
  (savings, total, one checkout button, payment icons). Express buttons stay on the product page
  and on Shopify checkout, so the footer never pushes the items out of view.

  Keeps the Dawn hooks cart.js / cart-drawer.js rely on:
  cart-drawer-items, #CartDrawer-Item-N, #Drawer-quantity-N, cart-remove-button[data-index],
  #CartDrawer-LineItemError-N, .loading__spinner, #CartDrawer-CartItems, .cart-drawer__footer.
{% endcomment %}

{{ 'quantity-popover.css' | asset_url | stylesheet_tag }}

<script src="{{ 'cart.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'quantity-popover.js' | asset_url }}" defer="defer"></script>

<style>
  .drawer {
    visibility: hidden;
  }
</style>

{%- liquid
  assign dg_pct = settings.bundle_discount_percent | default: 0
  assign dg_free_ship = settings.free_shipping_threshold | default: 40 | times: 100
  assign dg_save = 0
  for item in cart.items
    assign dg_base = item.variant.compare_at_price | default: 0
    if item.original_price > dg_base
      assign dg_base = item.original_price
    endif
    assign dg_diff = dg_base | times: item.quantity | minus: item.final_line_price
    if dg_diff > 0
      assign dg_save = dg_save | plus: dg_diff
    endif
  endfor
  for discount in cart.cart_level_discount_applications
    assign dg_save = dg_save | plus: discount.total_allocated_amount
  endfor
  assign dg_items_label = 'items'
  if cart.item_count == 1
    assign dg_items_label = 'item'
  endif
-%}

<cart-drawer class="drawer dgc{% if cart == empty %} is-empty{% endif %}">
  <div id="CartDrawer" class="cart-drawer">
    <div id="CartDrawer-Overlay" class="cart-drawer__overlay"></div>
    <div
      class="drawer__inner dgc__inner"
      role="dialog"
      aria-modal="true"
      aria-label="{{ 'sections.cart.title' | t }}"
      tabindex="-1"
    >
      {%- if cart == empty -%}
        <div class="drawer__inner-empty dgc-empty">
          <button
            class="drawer__close dgc__close"
            type="button"
            onclick="this.closest('cart-drawer').close()"
            aria-label="{{ 'accessibility.close' | t }}"
          >
            {% render 'dg-icon', name: 'x' %}
          </button>
          <div class="dgc-empty__body">
            <span class="dgc-empty__icon">{% render 'dg-icon', name: 'cap' %}</span>
            <h2 class="dgc-empty__title">Your cart is empty</h2>
            <p class="dgc-empty__text">Simple tools for your daily glow.</p>
            <a href="/pages/products" class="dgc-btn">
              Start shopping
            </a>
          </div>
        </div>
      {%- endif -%}

      <div class="drawer__header dgc-head">
        <h2 class="drawer__heading dgc-head__title">
          Your cart <span class="dgc-head__count">{{ cart.item_count }} {{ dg_items_label }}</span>
        </h2>
        <button
          class="drawer__close dgc__close"
          type="button"
          onclick="this.closest('cart-drawer').close()"
          aria-label="{{ 'accessibility.close' | t }}"
        >
          {% render 'dg-icon', name: 'x' %}
        </button>
      </div>

      <cart-drawer-items
        class="dgc-scroll{% if cart == empty %} is-empty{% endif %}"
        view-event-payload="{{ cart | standard_event_data: 'view', context: 'dialog' | escape }}"
        view-event-trigger="manual"
      >
        {%- if cart != empty -%}
          {%- comment -%} Rewards bar. The caps multi-buy nudge only shows when a cap
              is actually in the cart; below the free-shipping amount the bar tracks progress to it. {%- endcomment -%}
          {%- liquid
            assign dg_cap_count = 0
            for item in cart.items
              if item.product.handle == 'glow-cap'
                assign dg_cap_count = dg_cap_count | plus: item.quantity
              endif
            endfor
            assign dg_ship_left = dg_free_ship | minus: cart.total_price
            assign dg_ship_pct = cart.total_price | times: 100 | divided_by: dg_free_ship
          -%}
          <div class="dgc-rewards">
            {%- if dg_ship_left > 0 -%}
              <p class="dgc-rewards__msg">You're <strong>{{ dg_ship_left | money }}</strong> away from <strong>free shipping</strong></p>
              <div class="dgc-rewards__track"><span style="width: {{ dg_ship_pct }}%"></span></div>
            {%- elsif dg_pct > 0 and dg_cap_count == 1 -%}
              <p class="dgc-rewards__msg">You've unlocked <strong>free shipping</strong>. Add <strong>1 more cap</strong> to save <strong>{{ dg_pct }}%</strong> on both</p>
              <div class="dgc-rewards__track"><span style="width: 100%"></span></div>
            {%- elsif dg_pct > 0 and dg_cap_count > 1 -%}
              <p class="dgc-rewards__msg">You've unlocked <strong>{{ dg_pct }}% off your caps</strong> and <strong>free shipping</strong></p>
              <div class="dgc-rewards__track"><span style="width: 100%"></span></div>
            {%- else -%}
              <p class="dgc-rewards__msg">You've unlocked <strong>free shipping</strong></p>
              <div class="dgc-rewards__track"><span style="width: 100%"></span></div>
            {%- endif -%}
          </div>
        {%- endif -%}

        <form action="{{ routes.cart_url }}" id="CartDrawer-Form" class="cart__contents cart-drawer__form" method="post">
          <div id="CartDrawer-CartItems" class="drawer__contents js-contents">
            {%- if cart != empty -%}
              <ul class="dgc-items" role="list">
                {%- for item in cart.items -%}
                  {%- liquid
                    assign dg_img = item.image | default: item.product.featured_image
                    assign dg_base = item.variant.compare_at_price | default: 0
                    if item.original_price > dg_base
                      assign dg_base = item.original_price
                    endif
                    assign dg_line_cmp = dg_base | times: item.quantity
                    assign dg_line_save = dg_line_cmp | minus: item.final_line_price
                  -%}
                  <li id="CartDrawer-Item-{{ item.index | plus: 1 }}" class="cart-item dgc-item">
                    <a href="{{ item.url }}" class="dgc-item__media" tabindex="-1" aria-hidden="true">
                      {%- if dg_img -%}
                        <img src="{{ dg_img | image_url: width: 240 }}" alt="" loading="lazy" width="120" height="120">
                      {%- endif -%}
                    </a>

                    <div class="dgc-item__body">
                      <div class="dgc-item__top">
                        <a href="{{ item.url }}" class="cart-item__name dgc-item__name">{{ item.product.title | escape }}</a>
                        <cart-remove-button id="CartDrawer-Remove-{{ item.index | plus: 1 }}" data-index="{{ item.index | plus: 1 }}">
                          <button type="button" class="dgc-item__remove" aria-label="{{ 'sections.cart.remove_title' | t: title: item.title | escape }}">
                            {% render 'dg-icon', name: 'x' %}
                          </button>
                        </cart-remove-button>
                      </div>

                      {%- unless item.product.has_only_default_variant -%}
                        <p class="dgc-item__variant">
                          {%- for option in item.options_with_values -%}
                            {{ option.value }}{% unless forloop.last %} · {% endunless %}
                          {%- endfor -%}
                        </p>
                      {%- endunless -%}

                      {%- for property in item.properties -%}
                        {%- assign p_first = property.first | slice: 0 -%}
                        {%- if property.last != blank and p_first != '_' -%}
                          <p class="dgc-item__variant">{{ property.first }}: {{ property.last }}</p>
                        {%- endif -%}
                      {%- endfor -%}

                      {%- for discount in item.line_level_discount_allocations -%}
                        <p class="dgc-item__disc">{{ discount.discount_application.title }}</p>
                      {%- endfor -%}

                      <div class="dgc-item__bottom">
                        <quantity-input class="quantity cart-quantity dgc-qty">
                          <button class="quantity__button" name="minus" type="button">
                            <span class="visually-hidden">{{ 'products.product.quantity.decrease' | t: product: item.product.title | escape }}</span>
                            <span aria-hidden="true">&minus;</span>
                          </button>
                          <input
                            class="quantity__input"
                            type="number"
                            data-quantity-variant-id="{{ item.variant.id }}"
                            data-quantity-line-key="{{ item.key }}"
                            name="updates[]"
                            value="{{ item.quantity }}"
                            {% # theme-check-disable %}
                            data-cart-quantity="{{ cart | item_count_for_variant: item.variant.id }}"
                            min="0"
                            data-min="{{ item.variant.quantity_rule.min }}"
                            {% if item.variant.quantity_rule.max != null %}max="{{ item.variant.quantity_rule.max }}"{% endif %}
                            step="{{ item.variant.quantity_rule.increment }}"
                            {% # theme-check-enable %}
                            aria-label="{{ 'products.product.quantity.input_label' | t: product: item.product.title | escape }}"
                            id="Drawer-quantity-{{ item.index | plus: 1 }}"
                            data-index="{{ item.index | plus: 1 }}"
                          >
                          <button class="quantity__button" name="plus" type="button">
                            <span class="visually-hidden">{{ 'products.product.quantity.increase' | t: product: item.product.title | escape }}</span>
                            <span aria-hidden="true">+</span>
                          </button>
                        </quantity-input>

                        <div class="dgc-item__price cart-item__totals">
                          {%- render 'loading-spinner' -%}
                          {%- if dg_line_save > 0 -%}
                            <s>{{ dg_line_cmp | money }}</s>
                          {%- endif -%}
                          <strong>{{ item.final_line_price | money }}</strong>
                        </div>
                      </div>

                      {%- if dg_line_save > 0 -%}
                        <span class="dgc-item__save">You save {{ dg_line_save | money }}</span>
                      {%- endif -%}

                      <div id="CartDrawer-LineItemError-{{ item.index | plus: 1 }}" class="cart-item__error dgc-item__error" role="alert">
                        <small class="cart-item__error-text"></small>
                      </div>
                    </div>
                  </li>
                {%- endfor -%}
              </ul>

              {%- comment -%} Add a second cap {%- endcomment -%}
              {%- assign dg_line = cart.items | first -%}
              {%- if dg_pct > 0 and cart.items.size == 1 and cart.item_count == 1 and dg_line.product.handle == 'glow-cap' -%}
                {%- assign dg_keep = 100 | minus: dg_pct -%}
                {%- assign dg_duo = dg_line.final_price | times: 2 | times: dg_keep | divided_by: 100 -%}
                <div class="dgc-offer">
                  <span class="dgc-offer__tag">Most popular</span>
                  <div class="dgc-offer__row">
                    <div class="dgc-offer__media">
                      {%- assign dg_oimg = dg_line.image | default: dg_line.product.featured_image -%}
                      {%- if dg_oimg -%}<img src="{{ dg_oimg | image_url: width: 160 }}" alt="" loading="lazy" width="64" height="64">{%- endif -%}
                      <span class="dgc-offer__x2">×2</span>
                    </div>
                    <div class="dgc-offer__copy">
                      <span class="dgc-offer__title">Make it a pair, save {{ dg_pct }}%</span>
                      <span class="dgc-offer__text">One for you, one for someone you share your routine with. {{ dg_duo | money }} for both.</span>
                    </div>
                  </div>
                  <button type="button" class="dgc-offer__btn" data-dg-upsell data-line="1" data-variant="{{ dg_line.variant_id }}">
                    Add a second cap
                  </button>
                </div>
              {%- endif -%}

              <ul class="dgc-trust" role="list">
                <li>{% render 'dg-icon', name: 'truck' %}<span>Free shipping<br><small>On orders {{ dg_free_ship | money_without_trailing_zeros }}+</small></span></li>
                <li>{% render 'dg-icon', name: 'shield' %}<span>30-day money-back<br><small>From delivery</small></span></li>
                <li>{% render 'dg-icon', name: 'lock' %}<span>Secure checkout<br><small>Encrypted payment</small></span></li>
              </ul>
            {%- endif -%}
            <p id="CartDrawer-LiveRegionText" class="visually-hidden" role="status"></p>
            <p id="CartDrawer-LineItemStatus" class="visually-hidden" aria-hidden="true" role="status">
              {{ 'accessibility.loading' | t }}
            </p>
          </div>
          <div id="CartDrawer-CartErrors" role="alert"></div>
        </form>
      </cart-drawer-items>

      <div class="drawer__footer dgc-foot">
        <div class="cart-drawer__footer">
          {%- if cart.cart_level_discount_applications.size > 0 -%}
            <ul class="dgc-foot__disc" role="list">
              {%- for discount in cart.cart_level_discount_applications -%}
                <li><span>{{ discount.title | escape }}</span><span>−{{ discount.total_allocated_amount | money }}</span></li>
              {%- endfor -%}
            </ul>
          {%- endif -%}
          {%- if dg_save > 0 -%}
            <div class="dgc-foot__row dgc-foot__row--save"><span>You save</span><span>{{ dg_save | money }}</span></div>
          {%- endif -%}
          {%- if cart.total_price >= dg_free_ship -%}
            <div class="dgc-foot__row"><span>Shipping</span><span class="dgc-foot__free">Free</span></div>
          {%- else -%}
            <div class="dgc-foot__row"><span>Shipping</span><span>{{ settings.standard_shipping_label | default: 'Calculated at checkout' | escape }}</span></div>
          {%- endif -%}
          <div class="totals dgc-foot__row dgc-foot__row--total" role="status">
            <span class="totals__total">{% if cart.total_price >= dg_free_ship %}Total{% else %}Subtotal{% endif %}</span>
            <span class="totals__total-value">{{ cart.total_price | money_with_currency }}</span>
          </div>
        </div>

        <div class="cart__ctas dgc-foot__ctas">
          <button
            type="submit"
            id="CartDrawer-Checkout"
            class="cart__checkout-button dgc-btn dgc-btn--checkout"
            name="checkout"
            form="CartDrawer-Form"
            {% if cart == empty %}disabled{% endif %}
          >
            {% render 'dg-icon', name: 'lock' %}
            <span>Secure checkout</span>
          </button>
          <ul class="dgc-pay" role="list" aria-label="Payment methods">
            {%- for type in shop.enabled_payment_types -%}
              <li>{{ type | payment_type_svg_tag: class: 'dgc-pay__icon' }}</li>
            {%- endfor -%}
          </ul>
        </div>
      </div>
    </div>
  </div>
</cart-drawer>
