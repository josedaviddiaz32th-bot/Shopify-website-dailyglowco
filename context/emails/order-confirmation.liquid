{% comment %}
  The Daily Glow Co. — Order confirmation email (Shopify customer notification).
  Paste in Shopify admin: Settings > Notifications > Customer notifications > Order confirmation > Edit code.
  Subject line suggestion: Smoother-looking skin is on its way, {{ customer.first_name | default: 'friend' }}! ({{ order_name }})
  Copy rules (doc 00): results are "visibly smoother-looking", never removes/permanent/clinical claims; "Results vary".
{% endcomment %}
{%- capture email_title -%}Thank you for your order{%- endcapture -%}
{%- assign teal = '#17393D' -%}
{%- assign orange = '#F08A2C' -%}
{%- assign mist = '#EEF3F1' -%}
{%- assign ink_muted = '#5B7275' -%}
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ email_title }}</title>
  <style>
    body { margin: 0; padding: 0; background: {{ mist }}; }
    a { color: {{ teal }}; }
    @media (max-width: 600px) {
      .dg-wrap { width: 100% !important; }
      .dg-pad { padding-left: 20px !important; padding-right: 20px !important; }
      .dg-h1 { font-size: 26px !important; }
    }
  </style>
</head>
<body style="margin:0; padding:0; background:{{ mist }};">
  <div style="display:none; max-height:0; overflow:hidden;">Your order {{ order_name }} is confirmed, and smoother-looking mornings are on the way.</div>
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background:{{ mist }};">
    <tr>
      <td align="center" style="padding:24px 12px;">
        <table role="presentation" class="dg-wrap" width="600" cellpadding="0" cellspacing="0" border="0" style="width:600px; max-width:600px; background:#FFFFFF; border-radius:18px; overflow:hidden; font-family:Poppins, Helvetica, Arial, sans-serif; color:{{ teal }};">

          <!-- Header -->
          <tr>
            <td class="dg-pad" align="center" style="padding:28px 40px 8px;">
              <a href="{{ shop.url }}" style="text-decoration:none; color:{{ teal }};">
                {%- if shop.email_logo_url -%}
                  <img src="{{ shop.email_logo_url }}" alt="{{ shop.name }}" width="{{ shop.email_logo_width | default: 160 }}" style="display:block; border:0; max-width:100%; height:auto;">
                {%- else -%}
                  <span style="font-size:20px; font-weight:700;">{{ shop.name }}</span>
                {%- endif -%}
              </a>
            </td>
          </tr>

          <!-- Hero -->
          <tr>
            <td class="dg-pad" align="center" style="padding:20px 40px 8px;">
              <p style="margin:0 0 10px; font-size:12px; font-weight:600; letter-spacing:3px; text-transform:uppercase; color:{{ orange }};">Order {{ order_name }} &middot; confirmed</p>
              <h1 class="dg-h1" style="margin:0 0 12px; font-size:30px; line-height:1.2; font-weight:700; color:{{ teal }};">Hey{% if customer.first_name != blank %} {{ customer.first_name }}{% endif %}, smoother-looking skin is on its way!</h1>
              <p style="margin:0; font-size:16px; line-height:1.6; color:{{ ink_muted }};">Thank you so much for treating yourself. We're packing your Wrinkle Smooth patches with care right now, and the moment they ship we'll send your tracking link so you can follow them all the way to your door.</p>
            </td>
          </tr>

          <!-- Button -->
          <tr>
            <td align="center" style="padding:22px 40px 6px;">
              <a href="{{ order_status_url }}" style="display:inline-block; background:{{ orange }}; color:{{ teal }}; font-size:16px; font-weight:700; text-decoration:none; padding:15px 34px; border-radius:999px;">View your order</a>
            </td>
          </tr>

          <!-- What happens next -->
          <tr>
            <td class="dg-pad" style="padding:28px 40px 4px;">
              <h2 style="margin:0 0 14px; font-size:18px; font-weight:700;">From our hands to your nightstand</h2>
              <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
                <tr>
                  <td width="34" valign="top" style="padding:0 0 14px;"><div style="width:26px; height:26px; border-radius:50%; background:{{ teal }}; color:#FFFFFF; font-size:13px; font-weight:700; line-height:26px; text-align:center;">1</div></td>
                  <td valign="top" style="padding:2px 0 14px; font-size:15px; line-height:1.55;"><strong>We pack it with care.</strong> Your patches leave us within 1–3 business days.</td>
                </tr>
                <tr>
                  <td width="34" valign="top" style="padding:0 0 14px;"><div style="width:26px; height:26px; border-radius:50%; background:{{ teal }}; color:#FFFFFF; font-size:13px; font-weight:700; line-height:26px; text-align:center;">2</div></td>
                  <td valign="top" style="padding:2px 0 14px; font-size:15px; line-height:1.55;"><strong>Tracking lands in your inbox.</strong> We'll email it as soon as your order ships (it can take 24–48 hours to start updating).</td>
                </tr>
                <tr>
                  <td width="34" valign="top" style="padding:0;"><div style="width:26px; height:26px; border-radius:50%; background:{{ teal }}; color:#FFFFFF; font-size:13px; font-weight:700; line-height:26px; text-align:center;">3</div></td>
                  <td valign="top" style="padding:2px 0 0; font-size:15px; line-height:1.55;"><strong>Your new nighttime ritual arrives.</strong> Most orders arrive in about 6–11 days from today.</td>
                </tr>
              </table>
            </td>
          </tr>

          <!-- Order summary -->
          <tr>
            <td class="dg-pad" style="padding:28px 40px 0;">
              <h2 style="margin:0 0 6px; font-size:18px; font-weight:700;">Here's what's coming your way</h2>
              <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
                {%- for line in subtotal_line_items -%}
                  <tr>
                    <td width="72" valign="top" style="padding:14px 0; border-bottom:1px solid #E3EAE7;">
                      {%- if line.image -%}
                        <img src="{{ line | img_url: 'compact_cropped' }}" alt="" width="60" height="60" style="display:block; width:60px; height:60px; border-radius:10px; object-fit:cover; background:{{ mist }};">
                      {%- endif -%}
                    </td>
                    <td valign="top" style="padding:14px 10px; border-bottom:1px solid #E3EAE7; font-size:15px; line-height:1.4;">
                      <strong>{{ line.product.title | default: line.title }}</strong>
                      {%- if line.variant.title != blank and line.variant.title != 'Default Title' -%}
                        <br><span style="font-size:13px; color:{{ ink_muted }};">{{ line.variant.title }}</span>
                      {%- endif -%}
                      <br><span style="font-size:13px; color:{{ ink_muted }};">Qty {{ line.quantity }}</span>
                      {%- for allocation in line.discount_allocations -%}
                        <br><span style="font-size:13px; color:{{ orange }}; font-weight:600;">{{ allocation.discount_application.title }}</span>
                      {%- endfor -%}
                    </td>
                    <td valign="top" align="right" style="padding:14px 0; border-bottom:1px solid #E3EAE7; font-size:15px; white-space:nowrap;">
                      {%- if line.original_line_price != line.final_line_price -%}
                        <span style="font-size:13px; color:{{ ink_muted }}; text-decoration:line-through;">{{ line.original_line_price | money }}</span><br>
                      {%- endif -%}
                      <strong>{{ line.final_line_price | money }}</strong>
                    </td>
                  </tr>
                {%- endfor -%}
              </table>

              <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="margin-top:10px; font-size:15px;">
                <tr>
                  <td style="padding:5px 0; color:{{ ink_muted }};">Subtotal</td>
                  <td align="right" style="padding:5px 0;">{{ subtotal_price | money }}</td>
                </tr>
                {%- for discount_application in discount_applications -%}
                  {%- if discount_application.target_selection == 'all' -%}
                    <tr>
                      <td style="padding:5px 0; color:{{ ink_muted }};">Discount{% if discount_application.title != blank %} ({{ discount_application.title }}){% endif %}</td>
                      <td align="right" style="padding:5px 0; color:{{ orange }};">-{{ discount_application.total_allocated_amount | money }}</td>
                    </tr>
                  {%- endif -%}
                {%- endfor -%}
                {%- if requires_shipping -%}
                  <tr>
                    <td style="padding:5px 0; color:{{ ink_muted }};">Shipping</td>
                    <td align="right" style="padding:5px 0;">{% if shipping_price > 0 %}{{ shipping_price | money }}{% else %}Free{% endif %}</td>
                  </tr>
                {%- endif -%}
                {%- if tax_price > 0 -%}
                  <tr>
                    <td style="padding:5px 0; color:{{ ink_muted }};">Taxes</td>
                    <td align="right" style="padding:5px 0;">{{ tax_price | money }}</td>
                  </tr>
                {%- endif -%}
                <tr>
                  <td style="padding:12px 0 0; font-size:17px; font-weight:700; border-top:2px solid {{ teal }};">Total</td>
                  <td align="right" style="padding:12px 0 0; font-size:17px; font-weight:700; border-top:2px solid {{ teal }};">{{ total_price | money_with_currency }}</td>
                </tr>
                {%- if total_discounts > 0 -%}
                  <tr>
                    <td colspan="2" align="right" style="padding:6px 0 0; font-size:13px; font-weight:600; color:{{ orange }};">You saved {{ total_discounts | money }}</td>
                  </tr>
                {%- endif -%}
              </table>
            </td>
          </tr>

          <!-- Shipping address -->
          {%- if shipping_address -%}
            <tr>
              <td class="dg-pad" style="padding:24px 40px 0;">
                <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background:{{ mist }}; border-radius:12px;">
                  <tr>
                    <td style="padding:16px 18px; font-size:14px; line-height:1.55;">
                      <strong>Shipping to</strong><br>
                      {{ shipping_address.name }}<br>
                      {{ shipping_address.address1 }}{% if shipping_address.address2 != blank %}, {{ shipping_address.address2 }}{% endif %}<br>
                      {{ shipping_address.city }}{% if shipping_address.province_code != blank %}, {{ shipping_address.province_code }}{% endif %} {{ shipping_address.zip }}<br>
                      {{ shipping_address.country }}
                      <br><span style="font-size:13px; color:{{ ink_muted }};">Spotted a mistake? Reply to this email right away and we'll fix it before it ships.</span>
                    </td>
                  </tr>
                </table>
              </td>
            </tr>
          {%- endif -%}

          <!-- How to use -->
          <tr>
            <td class="dg-pad" style="padding:28px 40px 0;">
              <h2 style="margin:0 0 6px; font-size:18px; font-weight:700;">Your first night, made easy</h2>
              <p style="margin:0 0 14px; font-size:15px; line-height:1.6; color:{{ ink_muted }};">While you wait, here's how to make that first morning a good one.</p>
              <p style="margin:0 0 8px; font-size:15px; line-height:1.6;"><strong>Before bed:</strong> wash and fully dry your skin (no creams or oils under the patch). Gently smooth the area, press the patch on, and drift off.</p>
              <p style="margin:0 0 8px; font-size:15px; line-height:1.6;"><strong>Good morning:</strong> peel it off slowly and say hello to visibly smoother-looking skin.</p>
              <p style="margin:0 0 8px; font-size:15px; line-height:1.6;"><strong>Again tonight:</strong> rinse with mild soap and water, let it air-dry sticky side up, and pop it back on its backing. It's ready when you are.</p>
              <p style="margin:0; font-size:13px; line-height:1.55; color:{{ ink_muted }};">The more nights you wear them, the better the look. Results vary. Please skip broken or irritated skin, and if your skin is sensitive, try a patch for an hour first.</p>
            </td>
          </tr>

          <!-- Guarantee -->
          <tr>
            <td class="dg-pad" style="padding:26px 40px 0;">
              <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="border:2px solid {{ orange }}; border-radius:14px;">
                <tr>
                  <td width="74" align="center" valign="middle" style="padding:16px 0 16px 16px;">
                    <div style="width:58px; height:58px; border-radius:50%; background:#FFC24A; color:{{ teal }}; text-align:center; font-weight:700;">
                      <div style="font-size:20px; line-height:20px; padding-top:12px;">30</div>
                      <div style="font-size:9px; letter-spacing:1px;">DAYS</div>
                    </div>
                  </td>
                  <td valign="middle" style="padding:16px 18px 16px 12px; font-size:14px; line-height:1.55;">
                    <strong style="font-size:15px;">We've got you for 30 days.</strong><br>
                    If you don't love your mornings, just email us and we'll give you your money back. No hoops, no hard feelings.
                  </td>
                </tr>
              </table>
            </td>
          </tr>

          <!-- Help -->
          <tr>
            <td class="dg-pad" align="center" style="padding:28px 40px 30px;">
              <p style="margin:0 0 4px; font-size:15px; line-height:1.6;">Questions, or just want to say hi? Hit reply. A real person reads every email.</p>
              <p style="margin:0; font-size:15px;"><a href="mailto:support@thedailyglowco.com" style="color:{{ teal }}; font-weight:700;">support@thedailyglowco.com</a></p>
              <p style="margin:6px 0 0; font-size:13px; color:{{ ink_muted }};">We reply within 1–2 business days.</p>
              <p style="margin:22px 0 0; font-size:16px; line-height:1.5;">Sweet dreams,<br><strong>The Daily Glow Co. team</strong></p>
            </td>
          </tr>

          <!-- Footer -->
          <tr>
            <td align="center" style="background:{{ teal }}; padding:20px 30px; font-size:12px; line-height:1.6; color:#CFE0DC;">
              <span style="font-weight:700; letter-spacing:3px; color:#FFFFFF;">THE DAILY GLOW CO.</span><br>
              <a href="{{ shop.url }}/pages/track-order" style="color:#CFE0DC;">Track your order</a> &nbsp;·&nbsp; <a href="{{ shop.url }}/pages/products" style="color:#CFE0DC;">Shop patches</a>
            </td>
          </tr>

        </table>
      </td>
    </tr>
  </table>
</body>
</html>
